<!-- Place this file at /var/ossec/etc/rules/tpot_rules.xml on the Wazuh manager.
     IDs 100500-100505 are local examples. Check for collisions with existing rules. -->
<group name="tpot,cowrie,">
  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>T-Pot Cowrie event</description>
  </rule>

  <rule id="100501" level="5">
    <if_sid>100500</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Cowrie failed login</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100502" level="8">
    <if_sid>100500</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Cowrie simulated login succeeded</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100503" level="6">
    <if_sid>100500</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.command\.input$</field>
    <description>Cowrie shell command observed</description>
  </rule>

  <rule id="100504" level="10">
    <if_sid>100500</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.file_download$</field>
    <description>Cowrie observed a file download</description>
  </rule>

  <rule id="100505" level="10" frequency="5" timeframe="120" ignore="60">
    <if_matched_sid>100501</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie repeated failed logins from one source within 120 seconds</description>
    <group>authentication_failures,</group>
  </rule>
</group>
